# Telegram Bot Configuration
TELEGRAM_BOT_TOKEN=123456789:ABCdefGhIJKlmNoPQRsTUVwxyZ

# Nova Poshta API Settings
NOVA_POSHTA_API_KEY=your_nova_poshta_api_key_here

# AI Provider Configuration
# Options for AI_PROVIDER: openai_compatible | openai | gemini
AI_PROVIDER=openai_compatible
AI_BASE_URL=http://localhost:8081/v1
AI_API_KEY=not_needed_for_local_or_your_key
AI_MODEL=gemini-3.6-flash

# Default Sender Credentials (obtained via `python -m src.cli.fetch_sender_info` or Nova Poshta cabinet)
SENDER_CITY_REF=db5c88e0-391c-11dd-90d9-001a92567626
SENDER_COUNTERPARTY_REF=00000000-0000-0000-0000-000000000000
SENDER_CONTACT_REF=00000000-0000-0000-0000-000000000000
SENDER_ADDRESS_REF=00000000-0000-0000-0000-000000000000
SENDER_PHONE=380000000000

# Shipping Defaults
DEFAULT_PAYER_TYPE=Recipient
DEFAULT_PAYMENT_METHOD=Cash
DEFAULT_SERVICE_TYPE=WarehouseWarehouse
